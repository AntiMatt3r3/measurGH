---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ApproachBadge from '@/components/ApproachBadge.astro';
import EvidenceSummary from '@/components/EvidenceSummary.astro';
import SpecPanel from '@/components/SpecPanel.astro';
import ReferenceList from '@/components/ReferenceList.astro';
import FindingList from '@/components/FindingList.astro';
import objects from '@/data/objects.json';
import { evidenceForObject, specForObject, refsById } from '@/lib/data';
import { withBase, display } from '@/lib/utils';
export function getStaticPaths(){return objects.map((object)=>({params:{slug:object.slug},props:{object}}));}
const { object:o }=Astro.props; const ev=evidenceForObject(o.id); const spec=specForObject(o); const id=o.identity||{}; const syn=o.synthesis||{};
const considerations=[1,2,3,4,5].map(i=>syn[`things_to_consider_${i}`]).filter(Boolean);
const fields=[
  ['Type',o.subtype],['Primary construct',o.primaryConstruct],['Intended use',id.intended_use],['Respondent / data source',id.respondent_perspective],['Population / setting',id.intended_population],['Items / components',id.item_or_component_count],['Recall / observation window',id.recall_period],['Response format',id.response_options],['Administration',id.administration_mode],['Score / output',id.scoring_derivation],['Version / form',id.version_form],['Access / licence',id.licensing_access_status]
].filter(([,v])=>v);
const roleOrder=['DEFINING_DEVELOPMENT','REVISION_FORM_DEVELOPMENT','OFFICIAL_GUIDANCE_SPECIFICATION','PRIMARY_MEASUREMENT_METHOD_EVIDENCE','SECONDARY_EVIDENCE_SYNTHESIS','APPLICATION_EXAMPLE'];
const sortedRefs=[...ev.references].sort((a,b)=>roleOrder.indexOf(a.link.reference_role)-roleOrder.indexOf(b.link.reference_role));
---
<BaseLayout title={o.name}>
  <nav class="breadcrumbs"><a href={withBase('browse/')}>Browse</a><span>/</span><span>{o.approach}</span></nav>
  <section class="detail-head"><ApproachBadge approach={o.approach}/><h1>{o.name}</h1>{o.acronym && <p class="acronym">{o.acronym}</p>}<div class="tag-row">{o.subtype && <span class="tag">{o.subtype}</span>}{o.specificity && <span class="tag pale">{o.specificity}</span>}{o.status?.work_status==='COMPLETE'?<span class="status calibrated">Evidence characterised</span>:<span class="status mapped">Evidence pending</span>}</div>{o.familySlug && <p class="family-link">Part of <a href={withBase(`family/${o.familySlug}/`)}>{o.familyName}</a></p>}</section>

  <section class="panel"><div class="section-kicker">At a glance</div><h2>What is it?</h2><dl class="fact-grid">{fields.map(([k,v])=><div><dt>{k}</dt><dd>{display(v)}</dd></div>)}</dl>{o.constructs?.length>0 && <div class="construct-strip"><strong>Constructs</strong><div class="tag-row">{o.constructs.map(c=><span class="tag pale">{c.label}</span>)}</div></div>}{id.official_manual_or_developer_source && <p><a class="text-link" href={id.official_manual_or_developer_source} target="_blank" rel="noreferrer">Official/developer source ↗</a></p>}</section>

  <EvidenceSummary synthesis={syn} status={o.status}/>
  {considerations.length>0 && <section class="panel"><h2>Things to consider</h2><ul class="consider-list">{considerations.map(x=><li>{x}</li>)}</ul></section>}
  <SpecPanel spec={spec}/>

  {ev.applications.length>0 && <section class="panel"><h2>Examples of use</h2><div class="application-grid">{ev.applications.map(a=><article><h3>{a.population_setting || a.what_it_was_used_for}</h3><p>{a.brief_public_summary || a.what_it_was_used_for}</p>{a.country && <span class="tag pale">{a.country}</span>}</article>)}</div></section>}
  {ev.resources.length>0 && <section class="panel"><h2>Implementation resources</h2><div class="resource-list">{ev.resources.map(r=><article><h3>{r.resource_name || r.resource_type}</h3><p>{r.public_summary || r.intended_use}</p>{r.source_url_or_note && /^https?:/.test(r.source_url_or_note) && <a class="text-link" href={r.source_url_or_note} target="_blank" rel="noreferrer">Open resource ↗</a>}</article>)}</div></section>}

  <FindingList findings={ev.findings}/>
  <ReferenceList entries={sortedRefs}/>
  <section class="record-note"><strong>About this record</strong><p>This prototype page is generated from the current MeasureGH identity, construct and P1C-B evidence registers. Internal pipeline IDs are deliberately not used as public identifiers.</p></section>
</BaseLayout>
