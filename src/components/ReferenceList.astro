---
const { entries = [], title = 'References' } = Astro.props;
---
{entries.length > 0 && <section class="panel" aria-labelledby="refs-heading">
  <h2 id="refs-heading">{title}</h2>
  <div class="reference-list">
    {entries.map(({reference,link}) => <article class="reference-card">
      <h3>{reference.title || reference.citation_short}</h3>
      <p class="reference-meta">{reference.authors}{reference.year ? ` (${reference.year})` : ''}{reference.source_or_journal ? ` · ${reference.source_or_journal}` : ''}</p>
      <p><span class="tag">{String(link.reference_role || '').replaceAll('_',' ').toLowerCase()}</span>{link.exact_form_or_operationalisation && <span class="muted"> · {link.exact_form_or_operationalisation}</span>}</p>
      {(reference.url || reference.doi) && <p><a class="text-link" href={reference.url || `https://doi.org/${reference.doi}`} target="_blank" rel="noreferrer">Open source ↗</a></p>}
    </article>)}
  </div>
</section>}
