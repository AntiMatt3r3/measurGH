---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withBase } from '@/lib/utils';
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'MeasureGH — The Gambling Harms Measurement Toolkit', wide = false } = Astro.props;
const pageTitle = title === 'MeasureGH' ? title : `${title} | MeasureGH`;
const base = import.meta.env.BASE_URL || '/';
---
<!doctype html>
<html lang="en-GB" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123b4a" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class:list={['site-main', { wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
